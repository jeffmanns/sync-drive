{
  "name": "sync-drive",
  "version": "0.1.0",
  "description": "Compare an everyday Primary drive against its Replica, and bring the Replica up to date on approval.",
  "private": true,
  "type": "module",
  "bin": {
    "sync-drive": "dist/cli.js"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && npm run build:native",
    "test": "npm run typecheck && npm run build && node --test \"test/**/*.test.ts\"",
    "build:native": "mkdir -p dist/libexec && clang -std=c17 -O2 -Wall -Wextra -Werror -o dist/libexec/copy-with-metadata native/copy-with-metadata.c"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
